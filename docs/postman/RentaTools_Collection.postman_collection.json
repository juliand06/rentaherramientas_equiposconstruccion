            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{reservationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "{{reservationId}}"]
            }
          }
        },
        {
          "name": "4.3 Confirmar Reserva (Paso a Confirmada)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{reservationId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "{{reservationId}}", "confirm"]
            }
          }
        }
      ]
    },
