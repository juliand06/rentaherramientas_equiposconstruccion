# Copia este archivo a ".env" y cambia los valores. El archivo ".env" NO se sube a Git.
# Genera un secreto JWT largo con:  openssl rand -base64 48

# --- Perfil ---
SPRING_PROFILES_ACTIVE=dev

# --- Base de datos (PostgreSQL 16) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rentatools
DB_USER=rentatools
DB_PASSWORD=cambia-esta-clave

# --- Seguridad JWT ---
JWT_SECRET=cambia-este-secreto-por-uno-de-minimo-32-caracteres
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- CORS: orígenes permitidos, separados por comas ---
CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- Aplicación ---
SERVER_PORT=8080
UPLOADS_DIR=./uploads
SWAGGER_ENABLED=true

# --- Docker Compose: puertos publicados en el host ---
APP_PORT=8080
FRONTEND_PORT=8081
POSTGRES_PORT=5432
